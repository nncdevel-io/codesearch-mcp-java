{
  "_comment": "Credentials (optional). Copy to config/secrets.json, chmod 600, and DO NOT commit. Resolution: --secrets > CODE_SEARCH_SECRETS_PATH > repos.json secrets > ./config/secrets.json",
  "secrets": {
    "main-app": {
      "auth_type": "token",
